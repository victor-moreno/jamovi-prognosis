#: km/results/survTable.columns.title
msgid "Survival"
msgstr "Supervivència"

#: package.description
msgid ""
"Survival analysis for prognostic studies: Kaplan-Meier curves with rank "
"tests, and Cox regression with hazard-ratio tables, forest plots, "
"proportional-hazards checks and adjusted survival curves."
msgstr ""
"Anàlisi de supervivència per a estudis pronòstics: corbes de Kaplan-Meier "
"amb proves de rangs, i regressió de Cox amb taules de hazard ratios, forest "
"plots, comprovació de riscos proporcionals i corbes de supervivència "
"ajustades."

#: km/results/survTable.title
msgid "Survival at given times"
msgstr "Supervivència a temps donats"

#: km/options/survTimes.title
msgid "Survival at times"
msgstr "Supervivència als temps"

#: km/options/kmPlot.title
#: km/results/kmPlot.title
msgid "Survival curve"
msgstr "Corba de supervivència"

#: package/analyses/km.menuSubtitle
msgid "Survival curves and rank tests"
msgstr "Corbes de supervivència i proves de rangs"

#: R/utils.R
msgid "Survival probability"
msgstr "Probabilitat de supervivència"

#: km/results/summary.title
msgid "Survival summary"
msgstr "Resum de supervivència"

#: R/km.b.R
msgid ""
"Survival: Kaplan-Meier probability of being event-free at that time. Events: "
"cumulative events up to that time."
msgstr ""
"Supervivència: probabilitat de Kaplan-Meier d'estar lliure d'esdeveniment en "
"aquell temps. Esdeveniments: esdeveniments acumulats fins a aquell temps."

