msgstr "HR (IC 95%)"

#: R/cox.b.R
msgid ""
"HR > 1: higher hazard (worse prognosis) than the reference level, or per "
"one-unit increase of a covariate."
msgstr ""
"HR > 1: mayor riesgo (peor pronóstico) que el nivel de referencia, o por "
"cada aumento de una unidad de una covariable."

