#: package.description
msgid ""
"Survival analysis for prognostic studies: Kaplan-Meier curves with rank "
"tests, and Cox regression with hazard-ratio tables, forest plots, "
"proportional-hazards checks and adjusted survival curves."
msgstr ""
"Análisis de supervivencia para estudios pronósticos: curvas de Kaplan-Meier "
"con pruebas de rangos, y regresión de Cox con tablas de hazard ratios, "
"forest plots, comprobación de riesgos proporcionales y curvas de "
"supervivencia ajustadas."

#: km/results/survTable.title
msgid "Survival at given times"
msgstr "Supervivencia en tiempos dados"

#: km/options/survTimes.title
msgid "Survival at times"
msgstr "Supervivencia en los tiempos"

#: km/options/kmPlot.title
#: km/results/kmPlot.title
msgid "Survival curve"
msgstr "Curva de supervivencia"

#: package/analyses/km.menuSubtitle
msgid "Survival curves and rank tests"
msgstr "Curvas de supervivencia y pruebas de rangos"

#: R/utils.R
msgid "Survival probability"
msgstr "Probabilidad de supervivencia"

#: km/results/summary.title
msgid "Survival summary"
msgstr "Resumen de supervivencia"

#: R/km.b.R
msgid ""
"Survival: Kaplan-Meier probability of being event-free at that time. Events: "
"cumulative events up to that time."
msgstr ""
"Supervivencia: probabilidad de Kaplan-Meier de estar libre de evento en ese "
"tiempo. Eventos: eventos acumulados hasta ese tiempo."

